{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ikamva_lam (debug)",
      "cwd": "${workspaceFolder}/learner_app",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "toolArgs": [
        "--dart-define-from-file=${workspaceFolder}/.env",
        "--dart-define=IKAMVA_MODEL_DOWNLOAD_URL=https://huggingface.co/datasets/ikamva",
        "--dart-define=IKAMVA_MODEL_ESTIMATED_MB=2048",
        "--dart-define=IKAMVA_MODEL_MIN_FREE_MB=2048",
        "--dart-define=IKAMVA_MODEL_HEADROOM_MB=256"
      ]
    },
