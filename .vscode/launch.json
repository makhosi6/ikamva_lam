{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ikamva_lam (debug)",
      "cwd": "${workspaceFolder}/learner_app",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "toolArgs": [
        "--dart-define-from-file=${workspaceFolder}/.env"
      ]
    },
    {
      "name": "ikamva_lam (debug, model size defines only)",
      "cwd": "${workspaceFolder}/learner_app",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "toolArgs": [
        "--dart-define-from-file=${workspaceFolder}/.env",
        "--dart-define=IKAMVA_MODEL_ESTIMATED_MB=2048",
        "--dart-define=IKAMVA_MODEL_MIN_FREE_MB=2048"
      ]
    },
    {
      "name": "ikamva_lam (profile)",
      "cwd": "${workspaceFolder}/learner_app",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile",
      "program": "lib/main.dart",
      "toolArgs": [
        "--dart-define-from-file=${workspaceFolder}/.env"
      ]
    },
    {
      "name": "ikamva_lam (release)",
      "cwd": "${workspaceFolder}/learner_app",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release",
      "program": "lib/main.dart",
      "toolArgs": [
        "--dart-define-from-file=${workspaceFolder}/.env"
      ]
    }
  ]
}
